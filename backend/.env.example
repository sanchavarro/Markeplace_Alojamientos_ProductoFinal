# Copia este archivo como .env (en la carpeta backend) y llena los valores.
# .env NO se sube a GitHub. Escribe los valores sin comillas.

# Correo real con Gmail (contraseña de aplicación de 16 letras, sin espacios)
CORREO_MODO=smtp
CORREO_USUARIO=
CORREO_CLAVE=

# Stripe en modo pruebas (opcional). Con PAGOS_MODO=simulado no hace falta la llave.
PAGOS_MODO=simulado
STRIPE_SECRET_KEY=

# Solo en despliegue: secreto JWT largo y aleatorio
# JWT_SECRET=
