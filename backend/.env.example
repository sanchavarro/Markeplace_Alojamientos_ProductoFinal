# Copia este archivo como .env (en la carpeta backend) y llena los valores.
# .env NO se sube a GitHub. Escribe los valores sin comillas.

# Correo real con Gmail (contraseña de aplicación de 16 letras, sin espacios)
CORREO_MODO=smtp
CORREO_USUARIO=
CORREO_CLAVE=

# Stripe en modo pruebas (opcional). Con PAGOS_MODO=simulado no hace falta la llave.
PAGOS_MODO=simulado
STRIPE_SECRET_KEY=

# Solo en despliegue: secreto JWT largo y aleatorio
# JWT_SECRET=

# ─── Despliegue (Azure u otro servidor) ───────────────────────────────
# URL pública del frontend: la usan los enlaces de los correos y CORS.
# Mientras sea localhost, los botones de los correos solo abren en el computador que corre el backend.
# FRONTEND_URL=https://tu-frontend.azurestaticapps.net
# URL pública con la que se guardan las imágenes subidas
# ALMACENAMIENTO_URL=https://tu-backend.azurewebsites.net/imagenes
# Base de datos (Azure Database for PostgreSQL)
# DB_URL=jdbc:postgresql://tu-servidor.postgres.database.azure.com:5432/marketplace_db?sslmode=require
# DB_USUARIO=
# DB_CLAVE=
# Credenciales del administrador inicial y de las cuentas demo (el repositorio es público: cámbialas)
# ADMIN_CLAVE=
# DATOS_DEMO_CLAVE=
# Carpeta persistente para las imágenes subidas en Azure App Service
# ALMACENAMIENTO_RUTA=/home/uploads/imagenes
