# URL base del backend Spring Boot (server.port=8080 en application.properties).
# Sin barra final. Todas las rutas (/auth, /busqueda, /reservas...) cuelgan de la raíz: no hay prefijo /api.
VITE_API_BASE_URL=http://localhost:8080

# Intervalo (ms) para refrescar el contador de notificaciones no leídas en la campana del navbar.
VITE_NOTIFICACIONES_INTERVALO_MS=30000

# Intervalo (ms) para consultar el estado de las exportaciones de reportes en segundo plano.
VITE_EXPORTACIONES_INTERVALO_MS=4000

# Modo de pago por defecto enviado a POST /reservas y POST /reservas/{id}/pagar.
# Con pagos.modo=simulado el backend acepta: pm_card_visa (aprobado), pm_card_chargeDeclined (rechazado),
# pm_simular_caida y pm_simular_lento (pasarela no disponible).
VITE_METODO_PAGO_DEFECTO=pm_card_visa

# Contacto de la marca (footer y página de ayuda)
VITE_CORREO_CONTACTO=contacto@marketplace.com
VITE_TELEFONO_CONTACTO=+57 601 555 0100

# Redes sociales del footer (deja vacía una variable para ocultar ese ícono)
VITE_URL_INSTAGRAM=https://www.instagram.com/
VITE_URL_FACEBOOK=https://www.facebook.com/
VITE_URL_X=https://x.com/
VITE_URL_TIKTOK=https://www.tiktok.com/
VITE_URL_YOUTUBE=https://www.youtube.com/
